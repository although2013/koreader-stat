# ==========================================
# 1. Environment & Local Data Secrets
# ==========================================
# Exclude SQLite databases synced locally (contain personal reading DB)
*.sqlite3
*.db

# Environment variables & local secrets
.env
.env.local
.env.*.local

# Cloudflare / Wrangler local build & deployment artifacts
.wrangler/
.cloudflare/

# ==========================================
# 2. Python Environment & Outputs
# ==========================================
# Virtual environments
venv/
env/
.venv/
ENV/

# Python byte-code & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging outputs
build/
dist/
*.egg-info/

# ==========================================
# 3. Node.js & Web Frontend
# ==========================================
# Node dependency folders (if package managers are added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Public generated data (Optional: Uncomment the line below if reading_data.json 
# should ONLY be generated by GitHub Actions and NOT committed to Git)
# public/reading_data.json

# ==========================================
# 4. IDE & Editor Configs (VS Code)
# ==========================================
# Ignore all .vscode folder contents by default
.vscode/*

# Keep shared project settings & recommended extensions
!.vscode/settings.json
!.vscode/extensions.json

# macOS / OS system junk files
.DS_Store
Thumbs.db
